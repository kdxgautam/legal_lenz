# Google / Gemini
GOOGLE_APPLICATION_CREDENTIALS="$PWD/application_default_credentials.json"
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT="project-3e52c857-15d9-4fe6-b2f"
GOOGLE_CLOUD_LOCATION="global"

# Models
GENERATION_MODEL="gemini-3.5-flash-lite"
EMBEDDING_MODEL="gemini-embedding-2"

# Neon Postgres for local/student setup.
# Keep this quoted because Neon URLs often contain '&'.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&channel_binding=require"

# Cloud Run / Cloud SQL alternative. Leave blank when DATABASE_URL is set.
INSTANCE_CONNECTION_NAME=""
DB_NAME="legal_lenz"
DB_USER=""

# Private upload bucket.
UPLOAD_BUCKET="your-private-upload-bucket"

# Optional retrieval tuning. Defaults already match these values.
VECTOR_ORIGINAL_K=5
VECTOR_REWRITE_K=5
FTS_K=5
FUSION_K=10
RERANK_CANDIDATES=5
FINAL_CONTEXT_K=5
RRF_CONSTANT=60
EXACT_RRF_WEIGHT=3
RERANK_MIN_SCORE=0.5

# Optional integration-test database.
# TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST/testdb?sslmode=require&channel_binding=require"
